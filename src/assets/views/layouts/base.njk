<!DOCTYPE html>
<html lang="{{ lang or 'de' }}" dir="{{ dir or 'ltr' }}">
  <head>
    {#- Stylesheet -#}
    <link rel="stylesheet" href="{{ '/assets/styles/styles.css' | url }}" />

    {# Fonts #}
    <style>
      /* Normal */
      @font-face {
        font-family: "Merriweather";
        font-style: normal;
        font-weight: 0 699;
        font-display: swap;
        src: url(/assets/fonts/fontsource/merriweather-latin-400-normal.woff2) format("woff2");
      }

      /*  Bold */
      @font-face {
        font-family: "Merriweather";
        font-style: normal;
        font-weight: 700 999;
        font-display: swap;
        src: url(/assets/fonts/fontsource/merriweather-latin-700-normal.woff2) format("woff2");
      }

      @font-face {
        font-family: "Fira Code";
        font-style: normal;
        font-weight: 0 699;
        font-display: swap;
        src: url(/assets/fonts/fontsource/fira-code-latin-400-normal.woff2) format("woff2");
      }

      @font-face {
        font-family: "Fira Code";
        font-style: normal;
        font-weight: 700 999;
        font-display: swap;
        src: url(/assets/fonts/fontsource/fira-code-latin-700-normal.woff2) format("woff2");
      }
    </style>

    {#- Favicon -#}
    <link rel="icon" type="image/svg+xml" href="/assets/images/favicon.svg" />

    {#- Page title, meta tags, and other head elements -#} {%- include "partials/meta.njk" -%}
  </head>
  <body class="layout-grid">
    {#- Skip to content link -#}
    <a class="visually-hidden" href="#main">Skip to content</a>

    {#- Site header with navigation -#}
    <header class="l-feature">
      <div class="header-container breakout">
        <img src="" alt="" class="logo" />
        {%- include "partials/navigation.njk" -%}
      </div>
    </header>

    {#- Main content -#}
    <main id="main" class="layout-grid--forward" tabindex="-1" data-pagefind-body>
      <header id="page-header">
        <h1>{#- Page Title -#} {{ title | safe }}</h1>
      </header>

      {#- Content from the page or post -#} {{ content | safe }}
    </main>

    {#- Site footer with copyright -#}
    <footer id="footer" class="l-full">
      <small class="l-breakout">{%- year -%} &copy; {{ site.name }}</small>
    </footer>

    {#- Script bundle -#}
    <script src="{{ '/assets/scripts/main.js' | url }}"></script>
  </body>
</html>
